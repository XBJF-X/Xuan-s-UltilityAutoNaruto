# =========================================================
# Xuan 项目 .gitignore（适配 V2：backend + frontend 结构）
# =========================================================

# ---------- 运行数据 / 用户配置（不提交） ----------
# 多账号配置与默认任务（Config_N.json 等，含用户数据）
/config/
# 运行日志（Main.log 与按配置分目录）
/log/
# 全局设置（串口、模拟器安装路径等，含环境信息）
/setting.ini
# 场景识别底图（运行时资源，图片量大）
/test_scene/
# 场景资源 SQLite 数据库（本地数据）
/src/database.db

# ---------- 旧版本资源暂存（V1 遗留，测试稳定后手动删除） ----------
/del/

# ---------- OCR 模型（大体积二进制，不纳入版本控制） ----------
/utils/Base/OnnxOcr/

# ---------- 前端构建产物（由 pnpm build 生成，SPA 托管依赖） ----------
frontend/dist/
frontend/dist-electron/

# ---------- 环境 / 依赖 / 缓存 ----------
.venv/
node_modules/
.vite/
.idea/
.vscode/
*.local

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
*.egg
.pytest_cache/
.mypy_cache/
.htmlcov/
.coverage
.coverage.*

# ---------- Node / 包管理器调试日志 ----------
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- 日志 ----------
*.log

# ---------- 构建产物 / 打包 ----------
build/
dist/
*.spec



# 一些命令之类的
start_backend.bat
start_frontend.bat
Todo.txt